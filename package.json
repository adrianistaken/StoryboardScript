{
  "name": "storyboard-script",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write src tests *.ts *.js *.json"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.1",
    "@lucide/vue": "1.62.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@zip.js/zip.js": "2.24.0",
    "dexie": "4.4.7",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
